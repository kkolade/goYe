{
  "name": "goye",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile",
    "server",
    "shared"
  ],
  "scripts": {
    "start:mobile": "npm start --workspace=mobile",
    "start:web": "npm run dev --workspace=web",
    "start:server": "npm run dev --workspace=server",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\""
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkolade/goYe.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kkolade/goYe/issues"
  },
  "homepage": "https://github.com/kkolade/goYe#readme"
}
